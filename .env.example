# API key ของ AI provider (ใช้ได้กับทุก provider — Anthropic, OpenAI, OpenRouter, Groq, DeepSeek, ฯลฯ)
# เว้นว่างได้ แล้วไปตั้งในหน้า AI Config บนเว็บแทน
AI_API_KEY=
# Base URL ของ provider (เว้นว่าง = ใช้ค่า default ของ provider ที่เลือกในหน้า AI Config)
AI_BASE_URL=
ADMIN_USER=admin
# ตั้งค่าแล้วระบบ login จะเปิดใช้งาน (เว้นว่างไว้ = ไม่ต้อง login)
ADMIN_PASSWORD=xxx
